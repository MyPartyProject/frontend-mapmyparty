# =============================================================================
# MapMyParty FRONTEND — environment template (NO SECRETS)
# Copy to frontend-mapmyparty/.env
#
# Backend companion: ../server/.env.example
# Vite app: npm run dev (default port often 8080 — match server FRONTEND_URL)
# =============================================================================

# API base. Include host (+ optional /api). Client normalizes to .../api
# Local server default PORT in server/.env.example is 9090
VITE_API_BASE_URL=http://localhost:9090/api

# Google Maps (nearby / maps UI). Leave blank to skip map features that need it.
# VITE_GOOGLE_MAPS_API_KEY=

# Used by serverless share helpers (api/event-share.js) when deployed
# VITE_PUBLIC_APP_URL=http://localhost:8080
# PUBLIC_APP_URL=http://localhost:8080
# APP_ORIGIN=http://localhost:8080
# API_BASE_URL=http://localhost:9090/api
# MMP_API_BASE_URL=http://localhost:9090/api
